# @name listarCartItems
GET {{host}}/cart
Content-Type: application/json
Authorization: Bearer {{jwt_token}}

###
# @name adicionarCartItem
POST {{host}}/cart/add
Content-Type: application/json
Authorization: Bearer {{jwt_token}}

{
  "productId": 1,
  "quantity": 1
}

###
# @name DeleteCartItem
DELETE {{host}}/cart/item/1
Content-Type: application/json
Authorization: Bearer {{jwt_token}}

###
# @name limparCart
DELETE {{host}}/cart/items
Content-Type: application/json
Authorization: Bearer {{jwt_token}}
